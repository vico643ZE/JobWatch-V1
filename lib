export function locationMatches(job, profile) {
  const text = `${job.location || ""} ${job.region || ""}`;
  return (
    !profile.locations.length ||
    profile.locations.some(
      (place) =>
        hasTerm(text, place) ||
        (normalizeText(place) === "ile de france" &&
          (any(text, IDF) ||
