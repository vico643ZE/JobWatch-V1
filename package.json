{
  "name": "jobwatch",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "collect": "node --env-file-if-exists=.env.local scripts/collect.mjs",
    "source:check": "node --env-file-if-exists=.env.local scripts/source-check.mjs",
    "auth:setup": "node scripts/auth-setup.mjs",
    "verify:production": "node --env-file-if-exists=.env.local scripts/verify-production.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:http": "node scripts/e2e.mjs --http-only",
    "source:integration": "node scripts/live-integration.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0"
  }
}
